#!/usr/bin/env bash
# Fix the permissions that make a Wolf profile's first Steam launch crash.
#
# Steam in the GOW container needs /home/retro/.steam/ubuntu12_32/steam-runtime
# to exist and be owned by 1000:1000, but the directory Wolf creates for a new
# profile is not. Symptom: Steam dies immediately on the first run for a newly
# paired client.
#
# Usage: run Steam once from Moonlight (it will crash), then:
#
#     sudo wolf-steam-fixperms [profile_id]
#
# With no argument, lists the profiles that have a WolfSteam directory.
#
# Upstream ships an equivalent script that hardcodes BASE=/etc/wolf:
# https://games-on-whales.github.io/wolf/stable/apps/steam.html
#
# Note the directory is 'profile-data' with a hyphen, as upstream's script has
# it. Wolf's own documentation calls it 'profile_data'; that spelling is wrong.
# Both are accepted below in case it ever changes.

set -euo pipefail

# Where the wolf.container quadlet keeps Wolf's persistent state; this is the
# host side of the volume mounted at /etc/wolf inside the container.
BASE="${WOLF_STATE_DIR:-/var/lib/wolf}"
PROFILE_DATA="${BASE}/profile-data"
[ -d "${PROFILE_DATA}" ] || PROFILE_DATA="${BASE}/profile_data"

die() {
    echo "wolf-steam-fixperms: $*" >&2
    exit 1
}

list_profiles() {
    local found=0 dir profile
    for dir in "${PROFILE_DATA}"/*/WolfSteam; do
        [ -d "${dir}" ] || continue
        profile=$(basename "$(dirname "${dir}")")
        echo "  ${profile}"
        found=1
    done
    [ "${found}" -eq 1 ] || echo "  (none)"
}

[ -d "${PROFILE_DATA}" ] || die "no ${PROFILE_DATA}; has Wolf ever run? (systemctl status wolf)"

if [ $# -lt 1 ]; then
    echo "Usage: $0 <profile_id>"
    echo
    echo "Profiles with a Steam directory:"
    list_profiles
    exit 1
fi

profile_id=$1
steam_dir="${PROFILE_DATA}/${profile_id}/WolfSteam"

if [ ! -d "${steam_dir}" ]; then
    echo "No ${steam_dir}." >&2
    echo "Start the Steam app once as profile '${profile_id}' (it will crash), then re-run." >&2
    echo >&2
    echo "Known profiles:" >&2
    list_profiles >&2
    exit 1
fi

# The container runs apps as 1000:1000 by default (WOLF_DEFAULT_RUN_UID/GID).
mkdir -p "${steam_dir}/.steam/ubuntu12_32/steam-runtime"
chown -R 1000:1000 "${steam_dir}"
chmod -R 777 "${steam_dir}"

echo "Fixed ${steam_dir}"
echo "Launch Steam again; it should show the 'Updating Steam' dialogue."
