[Unit]
Description=Slice for games with elevated CPU priority
Documentation=man:systemd.slice(5)

[Slice]
# Launch a game into this slice from Steam launch options with:
#   systemd-run --user --slice=games.slice --scope -- %command%
# Note: IOWeight is intentionally omitted. Bazzite uses the kyber I/O
# scheduler for NVMe, which (like none/mq-deadline) ignores cgroup IOWeight;
# only BFQ enforces it. CPUWeight still applies.
CPUWeight=200
