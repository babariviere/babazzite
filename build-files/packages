# Package list for build.sh. One RPM per line, grouped under comment headers.
# Development toolchains live in the devbox (system-files/usr/share/babazzite/distrobox/dev.ini).

# apps
1password
fprintd-pam
ghostty
helium-bin

# fonts
fontawesome-fonts-all
nerd-fonts

# utility
fuse-sshfs
vulkan-tools
wl-clipboard
# runtime for host apps built in the devbox (anno)
webkit2gtk4.1

# streaming
# host + web console + plugin runner; punktfunk-web and punktfunk-scripting are
# only weak deps of punktfunk, so they are named explicitly
punktfunk
punktfunk-web
punktfunk-scripting

# game mode
# Bazzite's Steam Game Mode session is deck-only: gamescope-session-ogui-steam is
# installed in the bazzite-deck stage of Bazzite's Containerfile, not the desktop
# bazzite stage this image derives from. The desktop image does ship the gamescope
# binary (Bazzite installs terra-gamescope there itself), but nothing on top of it,
# so pull the session in explicitly. terra-gamescope Provides: gamescope, which
# satisfies gamescope-session's Requires: gamescope without reintroducing its
# Conflicts: gamescope.
#   gamescope-session       -> /usr/bin/gamescope-session-plus + the user units
#   gamescope-session-steam -> the wayland-session entry and the sessions.d/steam
#                              defaults that punktfunk's own drop-in at
#                              /etc/gamescope-session-plus/sessions.d/steam overrides
#                              to fall back to the headless backend on a box with no
#                              display connected
gamescope-session
gamescope-session-steam

# containers
podman
podman-bootc
podman-docker
podman-tui

# virtualization
libvirt
libvirt-daemon-config-network
virt-manager
virt-viewer

# networking
tailscale
wireguard-tools

# sound
# wireplumber is NOT listed: Bazzite ships terra-wireplumber in the base, and
# terra-wireplumber Conflicts: wireplumber, so naming it makes the build unsolvable.
# The mic chain is a PipeWire filter-chain (see dotfiles:
# .config/pipewire/pipewire.conf.d/99-mic-clean.conf), not easyeffects.
# It needs the CAPS noisegate; RNNoise comes from a LADSPA plugin in ~/.ladspa.
ladspa-caps-plugins
calf
lsp-plugins
lsp-plugins-clap
lsp-plugins-gstreamer
lsp-plugins-lv2
lsp-plugins-vst
lsp-plugins-vst3
